[Unit]
Description=LED Sports Scoreboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/mgamble/scoreboard
ExecStart=/home/mgamble/scoreboard/bin/python /home/mgamble/scoreboard/scoreboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
